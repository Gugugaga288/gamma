-- Nullscape Gamma v4
-- LIGHTING ONLY. Does not touch parts, materials or textures.
-- GUI is built first, so a lighting error can never stop the slider from showing.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local function safe(f, ...)
	local ok, err = pcall(f, ...)
	if not ok then warn("[NullGamma] " .. tostring(err)) end
	return ok
end

------------------------------------------------------------
-- TUNING (edit these if the look is off)
------------------------------------------------------------
local AMBIENT        = Color3.fromRGB(0, 0, 130)     -- shaded areas  (blue)
local OUTDOOR        = Color3.fromRGB(30, 0, 170)    -- outdoor shade (blue-violet)
local SHIFT_TOP      = Color3.fromRGB(255, 0, 170)   -- lit areas     (magenta)
local SHIFT_BOTTOM   = Color3.fromRGB(0, 0, 120)
local BRIGHTNESS     = 2.5                           -- sun strength at 100%
local TINT           = Color3.fromRGB(255, 70, 255)  -- screen tint (removes green)
local CONTRAST_1     = 0.7                           -- two stacked contrast passes =
local CONTRAST_2     = 0.6                           -- hard, posterized banding
local SATURATION     = 0.9
local SHADOW_SOFT    = 0.5                           -- Future shadow softness (noisy edges)

local alpha, enabled = 0.85, true
local function eff() return enabled and alpha or 0 end

------------------------------------------------------------
-- GUI PARENT
------------------------------------------------------------
local guiParent
do
	local ok, res = pcall(function() return gethui and gethui() end)
	if ok and res then
		guiParent = res
	else
		local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
		guiParent = (ok2 and cg) or Players.LocalPlayer:WaitForChild("PlayerGui")
	end
end
for _, n in ipairs({"NullGamma", "NullGammaOverlay"}) do
	safe(function() local o = guiParent:FindFirstChild(n); if o then o:Destroy() end end)
end
for _, v in ipairs(Lighting:GetChildren()) do
	if string.sub(v.Name, 1, 9) == "NullGamma" then v:Destroy() end
end

local lightingStep, lightingRestore = function() end, function() end
local overlayGui, overlay, overlayOK, noiseOn = nil, nil, false, false

