function FLerp(weld, targetCF, alpha)
    -- Create InitialCF if it doesn't exist
if not weld or not targetCF then return end
    weld.C0 = weld.C0:Lerp(weld.C0,targetCF, alpha)
end]]
function Mesh(parent,meshtype,meshid,textid,scale,offset)
	local part = i("SpecialMesh")
	part.MeshId = meshid or ""
	part.TextureId = textid or ""
	part.Scale = scale or v3(1,1,1)
	part.Offset = offset or v3_0
	part.MeshType = meshtype or Enum.MeshType.Sphere
	part.Parent = parent
	return part
end
