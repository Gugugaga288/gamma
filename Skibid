function Weld(part0,part1,c0,c1)
	local weld = i("Weld")
	weld.Parent = part0
	weld.Part0 = part0
	weld.Part1 = part1
	weld.C0 = c0 or cf_0
	weld.C1 = c1 or cf_0
	return weld
end
