function getMode(modeName)
	for i,v in next, modeInfo do
		if(v.Name==modeName)then
			return v
		end
	end
	return modeInfo[1]
end
function changeMode(modeName)
	local info = getMode(modeName)
	Mode=info.Name;
	humws=info.WalkSpeed;
	Q.Text = info.Name;
	Q.Font=info.Font;
	WingAnim=info.WingAnim or "Nameless1"
end
